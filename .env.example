# Copy to .env.local. Both values are public: the anon key only grants what
# row-level security allows. Never put the service-role key in this app.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Server-only (never VITE_-prefixed) ----
# Used by the local UI harness (npm run dev → /dev/analytics.html). Optional
# there: if unset, the harness falls back to your `vercel login` session.
# In production these become Vercel environment variables for the api/
# functions. The token can read every project in the team — keep it secret.
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_E35kb2OewhDFet6T0Iv99G9H
